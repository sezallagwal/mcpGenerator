{
    "name": "mcp-generator",
    "version": "0.1.0",
    "owner": "Sezal Lagwal",
    "description": "A minimal MCP generator extension for Gemini CLI",
    "contextFileName": "GEMINI.md",
    "mcpServers": {
        "mcp-generator": {
            "command": "node",
            "args": [
                "--import",
                "tsx",
                "${extensionPath}${/}src${/}server.ts"
            ],
            "cwd": "${extensionPath}"
        }
    }
}